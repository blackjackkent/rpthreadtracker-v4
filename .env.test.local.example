# Copy this to .env.test.local and fill in your values.
# .env.test.local is gitignored — never commit real credentials.

# Point at your local test database (separate from production)
# Create the database first: CREATE DATABASE RPThreadTracker_Test
# Then run: npx prisma db push to apply the schema
TEST_DATABASE_URL="sqlserver://localhost:49893;database=RPThreadTracker_Test;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true"

# Must match NEXTAUTH_SECRET in .env.local (tests use the same app instance)
# NEXTAUTH_SECRET is inherited from .env.local — only set here if different
