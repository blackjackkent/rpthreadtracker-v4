{
  "manifest_version": 3,
  "name": "RPThreadTracker QuickAdd",
  "description": "Quickly add a Tumblr thread to your RPThreadTracker account from any post page.",
  "version": "1.0.0",
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "RPThreadTracker QuickAdd"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{2ddc802a-c21a-4094-a975-65dc3ff6abdb}"
    }
  }
}
